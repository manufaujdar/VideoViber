# ─── Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Video Providers (BYOK) ────────────────────────────
# These are user-managed; stored encrypted in DB.
# Server-side only — never expose to client.
RUNWAY_API_KEY=
# Legacy fallback accepted by /api/generate for Veo-on-Gemini calls.
VEO_API_KEY=
LUMA_API_KEY=

# ─── Google Cloud (Vertex AI / Veo) ────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# ─── Auth ──────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ─── Observability ─────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Cross-Platform Callback Overrides ──────────────────
# Generic auth redirect base override (defaults to browser origin).
NEXT_PUBLIC_AUTH_REDIRECT_BASE_URL=
# Optional wrapper-specific overrides.
NEXT_PUBLIC_MOBILE_AUTH_REDIRECT_BASE_URL=
NEXT_PUBLIC_DESKTOP_AUTH_REDIRECT_BASE_URL=

# ─── Gemini (Google AI) ────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_API_KEY=
# Recommended defaults:
# - veo-3.1-generate-preview
# - veo-3.1-fast-generate-preview
GEMINI_VEO_MODEL=veo-3.1-generate-preview
